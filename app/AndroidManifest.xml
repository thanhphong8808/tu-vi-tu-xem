<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vn.tuvi.tuxem">

    <application
        android:name="vn.tuvi.app.TuViApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <activity
            android:name="vn.tuvi.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tệp tạm khi chia sẻ ảnh/PDF lá số: chỉ đọc, chỉ cấp quyền theo từng lần gửi. -->
        <provider
            android:name="vn.tuvi.app.ShareProvider"
            android:authorities="vn.tuvi.tuxem.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
